---
import '../styles/global.css'
import Header from '../components/Header.astro'
import Footer from '../components/Footer.astro'
import Analytics from '../components/Analytics.astro'
import { SITE } from '../config/site'
import { getRouteFromUrl } from '../i18n/utils'
import type { Lang } from '../i18n/ui'

interface Props {
  title: string
  lang: string
  description?: string
  image?: string
  noindex?: boolean
  /**
   * Path (after the language prefix) for each language, e.g.
   * { es: '/lp/automotriz/', en: '/lp/automotive/' }.
   * Required whenever the slug differs per language — deriving alternates from
   * the current URL would otherwise emit /en/lp/automotriz/, which is a 404 and
   * silently breaks hreflang.
   */
  pathByLang?: Record<string, string>
  /** JSON-LD objects rendered into <head>, one <script> each. */
  jsonLd?: Record<string, unknown>[]
  /** Page classification for analytics: 'home' | 'landing' | 'contact' | … */
  pageType?: string
  /** Stable landing ID from config/landings.ts, on campaign landings only. */
  landingId?: string
  /** 'offer' | 'segment', on campaign landings only. */
  landingKind?: string
}

const {
  title,
  lang,
  description = 'Laboratorio de Materiales y Ensayos Especializados — KAIBELAB',
  image = '/images/logo.jpeg',
  noindex = false,
  pathByLang,
  jsonLd = [],
  pageType = 'page',
  landingId,
  landingKind,
} = Astro.props

// Canonical + hreflang alternates. Use the explicit per-language paths when the
// page provides them; otherwise derive from the current route (same slug in
// both languages, which is the case for every static page).
const route = getRouteFromUrl(Astro.url).replace(/^\/+|\/+$/g, '')
const path = route ? `/${route}/` : '/'
const pathFor = (l: string) => pathByLang?.[l] ?? path

const canonical = new URL(`/${lang}${pathFor(lang)}`, SITE.url).href
const alternates = SITE.locales.map((l) => ({
  hreflang: l,
  href: new URL(`/${l}${pathFor(l)}`, SITE.url).href,
}))
const xDefault = new URL(`/${SITE.defaultLocale}${pathFor(SITE.defaultLocale)}`, SITE.url).href
const ogImage = new URL(image, SITE.url).href
const fullTitle = `${title} | KAIBELAB`

const pageContext = { page_type: pageType, language: lang, landing_id: landingId, landing_kind: landingKind }
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <title>{fullTitle}</title>
    {noindex && <meta name="robots" content="noindex, nofollow" />}

    <link rel="canonical" href={canonical} />
    {alternates.map((a) => <link rel="alternate" hreflang={a.hreflang} href={a.href} />)}
    <link rel="alternate" hreflang="x-default" href={xDefault} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="KAIBELAB" />
    <meta property="og:locale" content={lang === 'es' ? 'es_MX' : 'en_US'} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <!-- Structured data (Phase 2 · SEO) -->
    {jsonLd.map((schema) => (
      <script type="application/ld+json" is:inline set:html={JSON.stringify(schema)} />
    ))}

    <!--
      Fonts load without blocking the first paint: the stylesheet is fetched at
      low priority and promoted to `all` once ready. Montserrat already carries
      display=swap, so text renders immediately in the system fallback.
      The <noscript> copy keeps the font for scripting-disabled visitors.
    -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;500;600;700;800&display=swap"
      media="print"
      onload="this.media='all'; this.onload=null;"
    />
    <noscript>
      <link
        rel="stylesheet"
        href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;500;600;700;800&display=swap"
      />
    </noscript>
  </head>
  <body>
    <Analytics lang={lang as Lang} />
    <Header lang={lang} />
    <main>
      <slot />
    </main>
    <Footer lang={lang} />

    <!-- Floating WhatsApp button — expands on hover to show number -->
    <a
      href="https://wa.me/524497366489"
      target="_blank"
      rel="noopener noreferrer"
      aria-label="WhatsApp +52 449 736 6489"
      data-track-location="floating"
      class="group fixed bottom-6 right-6 z-50 flex items-center bg-[#25D366] hover:bg-[#1fba5a] shadow-lg hover:shadow-xl rounded-full overflow-hidden transition-all duration-300"
    >
      <span class="flex items-center justify-center w-14 h-14 shrink-0">
        <svg class="w-7 h-7 text-white" fill="currentColor" viewBox="0 0 24 24">
          <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
        </svg>
      </span>
      <span class="text-white text-sm font-semibold whitespace-nowrap overflow-hidden max-w-0 group-hover:max-w-48 group-hover:pr-5 transition-all duration-300">
        +52 449 736 6489
      </span>
    </a>

    <!-- Page context for analytics, read by scripts/tracking.ts -->
    <script type="application/json" id="kb-page-context" is:inline set:html={JSON.stringify(pageContext)} />
    <script>
      import { initTracking } from '../scripts/tracking'
      import { captureAttribution } from '../scripts/attribution'

      // Campaign parameters are captured on every page, not just landings, so a
      // visitor who arrives on a landing and converts on /contact keeps their source.
      captureAttribution()

      const el = document.getElementById('kb-page-context')
      const context = el?.textContent ? JSON.parse(el.textContent) : { page_type: 'page', language: 'es' }
      initTracking(context)
    </script>
  </body>
</html>
