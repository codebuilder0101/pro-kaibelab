---
import BaseLayout from '../../layouts/BaseLayout.astro'
import { useTranslations } from '../../i18n/utils'
import type { Lang } from '../../i18n/ui'

export function getStaticPaths() {
  return [{ params: { lang: 'es' } }, { params: { lang: 'en' } }]
}

const { lang } = Astro.params as { lang: Lang }
const t = useTranslations(lang)

const WHATSAPP_NUMBER = '524497366489'
const EMAIL = 'contacto@kaibelab.com'

const serviceOptions = lang === 'es'
  ? ['Intemperismo Acelerado','Colorimetría y Brillo','Espectroscopía','Evaluación de Materiales','Medición Especializada','Soporte Técnico Especializado','Otro']
  : ['Accelerated Weathering','Colorimetry & Gloss','Spectroscopy','Material Evaluation','Specialized Measurement','Specialized Technical Support','Other']
---

<BaseLayout title={t('contact.page.title')} lang={lang}>

  <section class="relative bg-primary text-white py-14 md:py-20 overflow-hidden">
    <div class="absolute inset-0">
      <img src="/images/lab-hero.webp" alt="" class="w-full h-full object-cover opacity-15" loading="lazy" decoding="async" />
      <div class="absolute inset-0 bg-primary/65"></div>
    </div>
    <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <p class="text-accent text-xs font-bold uppercase tracking-widest mb-2">KAIBELAB</p>
      <h1 class="text-4xl font-extrabold mb-3">{t('contact.page.title')}</h1>
      <p class="text-white/60 text-lg">{t('contact.page.subtitle')}</p>
    </div>
  </section>

  <section class="py-20 bg-white">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">

      <!-- Quick contact buttons -->
      <div class="flex flex-col sm:flex-row gap-4 mb-12">
        <a href={`https://wa.me/${WHATSAPP_NUMBER}`} target="_blank" rel="noopener noreferrer"
          class="flex items-center justify-center gap-3 bg-[#25D366] hover:bg-[#1fba5a] text-white font-semibold px-6 py-3 rounded transition-colors">
          <svg class="w-5 h-5 shrink-0" fill="currentColor" viewBox="0 0 24 24">
            <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
          </svg>
          {t('contact.whatsapp.label')}
        </a>
        <a href={`mailto:${EMAIL}`}
          class="flex items-center justify-center gap-3 border border-primary text-primary hover:bg-primary hover:text-white font-semibold px-6 py-3 rounded transition-colors">
          <svg class="w-5 h-5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
          </svg>
          {EMAIL}
        </a>
      </div>

      <div class="border-t border-gray-100 pt-12">
        <h2 class="text-2xl font-bold text-primary mb-8">
          {lang === 'es' ? 'Formulario de cotización' : 'Quote Request Form'}
        </h2>

        <form id="contact-form" class="space-y-6" novalidate>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
            <div>
              <label class="block text-sm font-medium text-gray-700 mb-1">{t('contact.form.name')}</label>
              <input id="f-name" type="text"
                class="w-full border border-gray-200 rounded px-4 py-2.5 text-sm focus:outline-none focus:border-accent transition-colors" />
            </div>
            <div>
              <label class="block text-sm font-medium text-gray-700 mb-1">{t('contact.form.company')}</label>
              <input id="f-company" type="text"
                class="w-full border border-gray-200 rounded px-4 py-2.5 text-sm focus:outline-none focus:border-accent transition-colors" />
            </div>
          </div>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
            <div>
              <label class="block text-sm font-medium text-gray-700 mb-1">{t('contact.form.email')}</label>
              <input id="f-email" type="email"
                class="w-full border border-gray-200 rounded px-4 py-2.5 text-sm focus:outline-none focus:border-accent transition-colors" />
            </div>
            <div>
              <label class="block text-sm font-medium text-gray-700 mb-1">{t('contact.form.phone')}</label>
              <input id="f-phone" type="tel"
                class="w-full border border-gray-200 rounded px-4 py-2.5 text-sm focus:outline-none focus:border-accent transition-colors" />
            </div>
          </div>
          <div>
            <label class="block text-sm font-medium text-gray-700 mb-1">{t('contact.form.service')}</label>
            <select id="f-service"
              class="w-full border border-gray-200 rounded px-4 py-2.5 text-sm focus:outline-none focus:border-accent transition-colors bg-white">
              <option value="">{t('contact.form.service.placeholder')}</option>
              {serviceOptions.map((opt) => <option value={opt}>{opt}</option>)}
            </select>
          </div>
          <div>
            <label class="block text-sm font-medium text-gray-700 mb-1">{t('contact.form.message')}</label>
            <textarea id="f-message" rows={5}
              class="w-full border border-gray-200 rounded px-4 py-2.5 text-sm focus:outline-none focus:border-accent transition-colors resize-none"></textarea>
          </div>

          <div class="flex flex-col sm:flex-row gap-4 pt-2">
            <button type="button" id="btn-email"
              class="flex-1 bg-primary hover:bg-primary/90 text-white font-semibold px-6 py-3 rounded text-sm transition-colors">
              {t('contact.form.send.email')}
            </button>
            <button type="button" id="btn-whatsapp"
              class="flex-1 bg-[#25D366] hover:bg-[#1fba5a] text-white font-semibold px-6 py-3 rounded text-sm transition-colors">
              {t('contact.form.send.whatsapp')}
            </button>
          </div>
        </form>
      </div>
    </div>
  </section>

</BaseLayout>

<script is:inline define:vars={{ WHATSAPP_NUMBER, EMAIL }}>
  function getFormData() {
    return {
      name:    document.getElementById('f-name').value.trim(),
      company: document.getElementById('f-company').value.trim(),
      email:   document.getElementById('f-email').value.trim(),
      phone:   document.getElementById('f-phone').value.trim(),
      service: document.getElementById('f-service').value,
      message: document.getElementById('f-message').value.trim(),
    }
  }

  function buildLines(d) {
    return [
      d.name    && `Nombre / Name: ${d.name}`,
      d.company && `Empresa / Company: ${d.company}`,
      d.email   && `Email: ${d.email}`,
      d.phone   && `Teléfono / Phone: ${d.phone}`,
      d.service && `Servicio / Service: ${d.service}`,
      d.message && `Mensaje / Message: ${d.message}`,
    ].filter(Boolean)
  }

  document.getElementById('btn-email').addEventListener('click', () => {
    const d = getFormData()
    const subject = encodeURIComponent('Solicitud de cotización | KAIBELAB')
    const body = encodeURIComponent(buildLines(d).join('\n'))
    window.open(`mailto:${EMAIL}?subject=${subject}&body=${body}`, '_blank')
  })

  document.getElementById('btn-whatsapp').addEventListener('click', () => {
    const d = getFormData()
    const text = encodeURIComponent('*Solicitud de cotización | KAIBELAB*\n\n' + buildLines(d).join('\n'))
    window.open(`https://wa.me/${WHATSAPP_NUMBER}?text=${text}`, '_blank')
  })
</script>
