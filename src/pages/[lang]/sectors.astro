---
import BaseLayout from '../../layouts/BaseLayout.astro'
import { useTranslations } from '../../i18n/utils'
import type { Lang } from '../../i18n/ui'

export function getStaticPaths() {
  return [{ params: { lang: 'es' } }, { params: { lang: 'en' } }]
}

const { lang } = Astro.params as { lang: Lang }
const t = useTranslations(lang)

const sectors = [
  'automotive',
  'plastics',
  'coatings',
  'electrical',
  'labels',
  'components',
  'rnd',
] as const
---

<BaseLayout title={t('sectors.page.title')} lang={lang} description={t('meta.sectors.desc')} pageType="sectors">

  <!-- Page hero -->
  <section class="relative bg-primary text-white py-14 md:py-20 overflow-hidden">
    <div class="absolute inset-0">
      <img src="/images/lab-hero.webp" alt="" class="w-full h-full object-cover opacity-15" loading="lazy" decoding="async" />
      <div class="absolute inset-0 bg-primary/65"></div>
    </div>
    <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <p class="text-accent text-xs font-bold uppercase tracking-widest mb-2">KAIBELAB</p>
      <h1 class="text-4xl font-extrabold mb-3">{t('sectors.page.title')}</h1>
      <p class="text-white/60 text-lg max-w-2xl">{t('sectors.page.subtitle')}</p>
    </div>
  </section>

  <!-- Sector cards -->
  <section class="py-20 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        {sectors.map((key) => (
          <div class="border border-gray-100 rounded-xl p-8 hover:border-accent hover:shadow-md transition-all group">
            <div class="w-10 h-0.5 bg-accent mb-5 group-hover:w-14 transition-all duration-300"></div>
            <h2 class="text-xl font-bold text-primary mb-3 group-hover:text-accent transition-colors">
              {t(`sectors.${key}.name` as any)}
            </h2>
            <p class="text-gray-500 leading-relaxed text-sm">
              {t(`sectors.${key}.desc` as any)}
            </p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="py-16 bg-primary text-white text-center">
    <div class="max-w-2xl mx-auto px-4">
      <p class="text-accent text-xs font-bold uppercase tracking-widest mb-3">
        {lang === 'es' ? 'Cadena de suministro automotriz y más' : 'Automotive supply chain and beyond'}
      </p>
      <h2 class="text-2xl font-bold mb-4">
        {lang === 'es'
          ? 'Atendemos a empresas Tier 1, 2, 3 y 4, así como a Centros de Investigación y de Desarrollo Tecnológico'
          : 'We serve Tier 1, 2, 3 & 4 companies and Technology Research & Development Centers'}
      </h2>
      <p class="text-white/60 mb-8 leading-relaxed">
        {lang === 'es'
          ? 'Si su organización requiere ensayos de materiales con respaldo normativo internacional, KAIBELAB tiene la capacidad y el rigor técnico para responder.'
          : 'If your organization requires material testing backed by international standards, KAIBELAB has the capacity and technical rigor to deliver.'}
      </p>
      <a href={`/${lang}/contact`} data-track="cta" data-track-location="sectors-final"
        class="bg-accent hover:bg-accent-dark text-white font-semibold px-8 py-3 rounded text-sm transition-colors">
        {t('nav.cta')}
      </a>
    </div>
  </section>

</BaseLayout>
