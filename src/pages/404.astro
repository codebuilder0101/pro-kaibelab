---
import BaseLayout from '../layouts/BaseLayout.astro'
---

<BaseLayout title="404" lang="es" pageType="404" noindex={true}>
  <section class="py-40 text-center">
    <div class="max-w-md mx-auto px-4">
      <div class="text-8xl font-extrabold text-primary/10 mb-4">404</div>
      <h1 class="text-2xl font-bold text-primary mb-2">Página no encontrada</h1>
      <p class="text-gray-400 mb-8">Page not found</p>
      <a href="/es/" class="bg-accent hover:bg-accent-dark text-white font-semibold px-6 py-2.5 rounded text-sm transition-colors">
        ← Inicio / Home
      </a>
    </div>
  </section>
</BaseLayout>
