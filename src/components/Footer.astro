---
import { useTranslations } from '../i18n/utils'
import type { Lang } from '../i18n/ui'

interface Props { lang: string }

const { lang } = Astro.props
const t = useTranslations(lang as Lang)

const navLinks = [
  { key: 'nav.home' as const,      href: `/${lang}/` },
  { key: 'nav.services' as const,  href: `/${lang}/services` },
  { key: 'nav.sectors' as const,   href: `/${lang}/sectors` },
  { key: 'nav.standards' as const, href: `/${lang}/standards` },
  { key: 'nav.about' as const,     href: `/${lang}/about` },
  { key: 'nav.contact' as const,   href: `/${lang}/contact` },
]
---

<footer class="bg-primary text-white">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">

      <div>
        <div class="flex items-center gap-3 mb-3">
          <img src="/images/logo.jpeg" alt="KAIBELAB" class="h-10 w-auto object-contain rounded-sm" loading="lazy" />
          <span class="text-xl font-extrabold tracking-widest leading-none">
            <span class="text-white">KAIBE</span><span class="text-accent">LAB</span>
          </span>
        </div>
        <div class="text-xs text-accent/80 font-medium mb-3">{t('site.tagline')}</div>
        <p class="text-sm text-white/50">Aguascalientes, México</p>
      </div>

      <div>
        <h3 class="text-xs font-bold uppercase tracking-widest text-accent mb-4">
          {lang === 'es' ? 'Navegación' : 'Navigation'}
        </h3>
        <ul class="space-y-2">
          {navLinks.map(({ key, href }) => (
            <li>
              <a href={href} class="text-sm text-white/60 hover:text-accent transition-colors">{t(key)}</a>
            </li>
          ))}
        </ul>
      </div>

      <div>
        <h3 class="text-xs font-bold uppercase tracking-widest text-accent mb-4">
          {lang === 'es' ? 'Contacto' : 'Contact'}
        </h3>
        <ul class="space-y-3">
          <li>
            <a href="https://wa.me/524497366489" target="_blank" rel="noopener noreferrer"
              class="flex items-center gap-2 text-sm text-white/60 hover:text-accent transition-colors">
              <svg class="w-4 h-4 shrink-0" fill="currentColor" viewBox="0 0 24 24">
                <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
              </svg>
              +52 449 736 6489
            </a>
          </li>
          <li>
            <a href="mailto:contacto@kaibelab.com"
              class="flex items-center gap-2 text-sm text-white/60 hover:text-accent transition-colors">
              <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
              </svg>
              contacto@kaibelab.com
            </a>
          </li>
        </ul>
      </div>
    </div>

    <div class="border-t border-white/10 mt-10 pt-6 text-center text-xs text-white/30">
      {t('site.footer.legal')}
    </div>
  </div>
</footer>
