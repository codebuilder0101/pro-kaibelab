---
import { useTranslations, getRouteFromUrl } from '../i18n/utils'
import type { Lang } from '../i18n/ui'

interface Props { lang: string }

const { lang } = Astro.props
const t = useTranslations(lang as Lang)
const otherLang = lang === 'es' ? 'en' : 'es'
const currentRoute = getRouteFromUrl(Astro.url)
const otherLangHref = `/${otherLang}/${currentRoute}`

const navLinks = [
  { key: 'nav.home' as const,      href: `/${lang}/` },
  { key: 'nav.services' as const,  href: `/${lang}/services` },
  { key: 'nav.sectors' as const,   href: `/${lang}/sectors` },
  { key: 'nav.standards' as const, href: `/${lang}/standards` },
  { key: 'nav.about' as const,     href: `/${lang}/about` },
  { key: 'nav.contact' as const,   href: `/${lang}/contact` },
]
---

<header class="bg-primary text-white sticky top-0 z-50 shadow-md border-b border-white/10">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-16">

      <a href={`/${lang}/`} class="flex items-center gap-3 shrink-0">
        <img
          src="/images/logo.jpeg"
          alt="KAIBELAB"
          class="h-9 w-auto object-contain rounded-sm"
          loading="eager"
          decoding="async"
        />
        <span class="text-base font-extrabold tracking-widest leading-none hidden sm:block">
          <span class="text-white">KAIBE</span><span class="text-accent">LAB</span>
        </span>
      </a>

      <nav class="hidden md:flex items-center gap-5">
        {navLinks.map(({ key, href }) => (
          <a href={href} class="text-sm font-medium text-white/80 hover:text-accent transition-colors">
            {t(key)}
          </a>
        ))}
      </nav>

      <div class="flex items-center gap-3 shrink-0">
        <a href={otherLangHref}
          class="text-xs font-bold uppercase border border-white/30 rounded px-2 py-1 hover:bg-white/10 transition-colors">
          {otherLang.toUpperCase()}
        </a>
        <a href={`/${lang}/contact`}
          class="hidden sm:block bg-accent hover:bg-accent-dark text-white text-sm font-semibold px-4 py-2 rounded transition-colors whitespace-nowrap">
          {t('nav.cta')}
        </a>
        <button id="mobile-menu-btn" class="md:hidden p-2 rounded hover:bg-white/10" aria-label="Toggle menu">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/>
          </svg>
        </button>
      </div>
    </div>

    <div id="mobile-menu" class="hidden md:hidden pb-4 border-t border-white/10 pt-3">
      <nav class="flex flex-col gap-3">
        {navLinks.map(({ key, href }) => (
          <a href={href} class="text-sm font-medium text-white/80 hover:text-accent transition-colors">
            {t(key)}
          </a>
        ))}
        <a href={`/${lang}/contact`}
          class="mt-2 bg-accent hover:bg-accent-dark text-white text-sm font-semibold px-4 py-2 rounded text-center transition-colors">
          {t('nav.cta')}
        </a>
      </nav>
    </div>
  </div>
</header>

<script>
  const btn = document.getElementById('mobile-menu-btn')
  const menu = document.getElementById('mobile-menu')
  btn?.addEventListener('click', () => menu?.classList.toggle('hidden'))
</script>
